{
	"luci-mod-status-autoset": {
		"description": "Grant access to autoset",
		"read": {
			"ubus": {
				"luci": [ "getCPUInfo", "getTempInfo", "getCPUBench", "getCPUUsage", "getOnlineUsers" ],
				"file": [ "exec" ]
			},
			"file": {
				"/usr/lib/os-release": [ "read" ],
				"/sbin/usage": [ "exec" ]
			}
		}
	}
}
