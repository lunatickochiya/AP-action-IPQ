diff --git a/target/linux/mediatek/dts/mt7986a-supergateway-s20m.dts b/target/linux/mediatek/dts/mt7986a-supergateway-s20m.dts
new file mode 100644
index 0000000000..46c6ba3fbd
--- /dev/null
