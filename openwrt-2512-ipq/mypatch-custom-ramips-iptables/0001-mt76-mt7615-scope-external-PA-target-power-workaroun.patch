From 3aaf8b5e098295f0b4093f50e35ac376c9b22f97 Mon Sep 17 00:00:00 2001
From: lunatickochiya <lunaticurey@gmail.com>
Date: Thu, 13 Aug 2026 20:54:08 +0800
Subject: [PATCH] mt76:mt7615: scope external PA target power workaround to
 MSG1500

---
 .../990-mt7615-msg1500-ext-pa-fix.patch       | 78 +++++++++++++++++++
 1 file changed, 78 insertions(+)
 create mode 100644 package/kernel/mt76/patches/990-mt7615-msg1500-ext-pa-fix.patch

diff --git a/package/kernel/mt76/patches/990-mt7615-msg1500-ext-pa-fix.patch b/package/kernel/mt76/patches/990-mt7615-msg1500-ext-pa-fix.patch
new file mode 100644
index 0000000000..732cf3dc7f
--- /dev/null
+++ b/package/kernel/mt76/patches/990-mt7615-msg1500-ext-pa-fix.patch
@@ -0,0 +1,78 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: OpenWrt device support <openwrt@example.invalid>
+Date: Thu, 13 Aug 2026 20:30:00 +0800
+Subject: [PATCH] mt7615: scope external PA target power workaround to MSG1500
+
+The RAISECOM MSG1500 X.00 has external two-chain 5 GHz PAs, while its
+EEPROM byte MT_EE_EXT_PA_5G_TARGET_POWER (0xf3) is 0x00.  Using that
+byte as a target-power reference limits 5 GHz output severely.
+
+The generic workaround from mt76 issue #804 removes the external-PA path
+for every MT7615 board and also changes the 2.4 GHz chain-power behavior.
+Limit the workaround to the 5 GHz side of MSG1500.  For this board use its
+per-channel 5 GHz tables (0x70...0x93 and 0x98...0xbb) and two chains; all
+other boards and the 2.4 GHz side retain the original driver behavior.
+
+This patch replaces the global issue #804 patch.  Do not apply both.
+
+---
+ mt7615/eeprom.c | 3 ++-
+ mt7615/eeprom.h | 8 ++++++++
+ mt7615/init.c   | 3 ++-
+ 3 files changed, 12 insertions(+), 2 deletions(-)
+
+diff --git a/mt7615/eeprom.h b/mt7615/eeprom.h
+--- a/mt7615/eeprom.h
++++ b/mt7615/eeprom.h
+@@ -5,6 +5,7 @@
+ #ifndef __MT7615_EEPROM_H
+ #define __MT7615_EEPROM_H
+ 
++#include <linux/of.h>
+ #include "mt7615.h"
+ 
+ 
+@@ -102,6 +103,13 @@ mt7615_get_channel_group(int channel)
+ 	return MT_CH_5G_UNII_3;
+ }
+ 
++static inline bool
++mt7615_msg1500_ext_pa_5g(enum nl80211_band band)
++{
++	return band == NL80211_BAND_5GHZ &&
++	       of_machine_is_compatible("raisecom,msg1500-x-00");
++}
++
+ static inline bool
+ mt7615_ext_pa_enabled(struct mt7615_dev *dev, enum nl80211_band band)
+ {
+diff --git a/mt7615/eeprom.c b/mt7615/eeprom.c
+--- a/mt7615/eeprom.c
++++ b/mt7615/eeprom.c
+@@ -204,7 +204,8 @@ int mt7615_eeprom_get_target_power_index(struct mt7615_dev *dev,
+ 	if (chain_idx > 3)
+ 		return -EINVAL;
+ 
+ 	/* TSSI disabled */
+-	if (mt7615_ext_pa_enabled(dev, chan->band)) {
++	if (mt7615_ext_pa_enabled(dev, chan->band) &&
++	    !mt7615_msg1500_ext_pa_5g(chan->band)) {
+ 		if (chan->band == NL80211_BAND_2GHZ)
+ 			return MT_EE_EXT_PA_2G_TARGET_POWER;
+ 		else
+diff --git a/mt7615/init.c b/mt7615/init.c
+--- a/mt7615/init.c
++++ b/mt7615/init.c
+@@ -284,7 +284,8 @@ void mt7615_init_txpower(struct mt7615_dev *dev,
+ 	if ((rate_val & ~MT_EE_RATE_POWER_MASK) ==
+ 	    (MT_EE_RATE_POWER_EN | MT_EE_RATE_POWER_SIGN))
+ 		delta += rate_val & MT_EE_RATE_POWER_MASK;
+ 
+-	if (!is_mt7663(&dev->mt76) && mt7615_ext_pa_enabled(dev, band))
++	if (!is_mt7663(&dev->mt76) && mt7615_ext_pa_enabled(dev, band) &&
++	    !mt7615_msg1500_ext_pa_5g(band))
+ 		target_chains = 1;
+ 	else
+ 		target_chains = n_chains;
+-- 
+2.43.0
-- 
2.55.0

